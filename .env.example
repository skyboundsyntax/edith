# ==============================================================================
# EDITH DATA INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION (SDD 1.0)
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME="AI-Powered Data Intelligence Platform"
VERSION="1.0.0"
DEBUG=True

# --- Database (SDD Section 2.2) ---
# Default SQLite local database. For production PostgreSQL (Supabase/Neon), replace with:
# DATABASE_URL=postgresql://user:password@localhost:5432/edith_db
DATABASE_URL="sqlite:///./data_intelligence.db"

# --- Autonomous Search & AI Keys (SDD Section 2.1) ---
# Tavily Search API key for source discovery (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# LLM Providers for intent parsing and advanced semantic reasoning
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# TypeSafe AI Jev Model API key (for external enterprise hosted Jev endpoint)
TYPESAFE_JEV_API_KEY=your_typesafe_jev_key_here

# --- Server Ports & URLs ---
PORT=8000
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
