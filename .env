# ==============================================================================
# EDITH JOB INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME="EDITH - Autonomous Job Intelligence Platform"
VERSION="1.0.0"
DEBUG=True

# --- Database ---
# Default SQLite local database
DATABASE_URL="sqlite:///./data_intelligence.db"

# --- Optional Search & LLM Keys ---
# Tavily Search API key (optional fallback for general web intelligence)
TAVILY_API_KEY=

# LLM Providers for intent parsing and advanced semantic reasoning (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Server Ports & URLs ---
PORT=8000
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
